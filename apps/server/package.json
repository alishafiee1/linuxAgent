{
  "name": "@linux-agent/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "vitest run --config e2e/vitest.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@fastify/compress": "^8.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.0",
    "@playwright/mcp": "0.0.84",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "otplib": "^12.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@linux-agent/shared": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
