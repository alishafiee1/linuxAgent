[Unit]
Description=Daily backup of the linuxAgent database (keeps 7)

[Service]
Type=oneshot
User=panel
ExecStart=/bin/sh -c 'mkdir -p /var/backups/cwp && sqlite3 /var/lib/cwp/cwp.db ".backup /var/backups/cwp/cwp-$(date +%%Y%%m%%d).db" && ls -1t /var/backups/cwp/cwp-*.db | tail -n +8 | xargs -r rm -f'
