{
  "name": "linux-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal web panel for Claude agents on an always-on Linux container",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "e2e": "pnpm --filter @linux-agent/server e2e",
    "dev:server": "pnpm --filter @linux-agent/server dev",
    "dev:web": "pnpm --filter @linux-agent/web dev",
    "cwp": "pnpm --filter @linux-agent/server cli"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
